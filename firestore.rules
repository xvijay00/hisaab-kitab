rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnerOfBusiness(bizId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/businesses/$(bizId)).data.ownerUid == request.auth.uid ||
        get(/databases/$(database)/documents/businesses/$(bizId)/members/$(request.auth.uid)).data.role == "owner"
      );
    }

    function isMemberOfBusiness(bizId) {
      return isAuthenticated() && (
        isOwnerOfBusiness(bizId) ||
        exists(/databases/$(database)/documents/businesses/$(bizId)/members/$(request.auth.uid))
      );
    }

    // User profile document
    match /users/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Multi-tenant business document
    match /businesses/{bizId} {
      // Allow reading if user is a member of the business
      allow read: if isMemberOfBusiness(bizId);

      // Allow creating a new business if authenticated
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;

      // Allow updating or deleting only if user is an owner
      allow update, delete: if isOwnerOfBusiness(bizId);

      // Business Members subcollection
      match /members/{memberId} {
        allow read: if isMemberOfBusiness(bizId);
        allow create, update, delete: if isOwnerOfBusiness(bizId);
      }

      // Business Categories subcollection
      match /categories/{categoryId} {
        allow read: if isMemberOfBusiness(bizId);
        allow create, update, delete: if isOwnerOfBusiness(bizId);
      }

      // Business Transactions subcollection
      match /transactions/{transactionId} {
        // Any member (staff or owner) can read transactions in their business
        allow read: if isMemberOfBusiness(bizId);

        // Any member can create a daily transaction
        allow create: if isMemberOfBusiness(bizId) &&
          request.resource.data.businessId == bizId &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.amount is int &&
          request.resource.data.amount > 0;

        // ONLY owners can edit or delete existing transactions
        // Staff members are blocked from deleting or editing old records
        allow update, delete: if isOwnerOfBusiness(bizId);
      }
    }
  }
}
